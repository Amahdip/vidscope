{
  "name": "vidscope",
  "version": "0.1.0",
  "description": "See the bytes inside video files: an interactive anatomy viewer for MP4/MOV (ISO-BMFF), Matroska/WebM, MPEG-TS, AVI and FLV.",
  "type": "module",
  "bin": {
    "vidscope": "bin/vidscope.js"
  },
  "scripts": {
    "start": "node bin/vidscope.js samples",
    "samples": "sh scripts/make-samples.sh",
    "registry": "node scripts/update-registry.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
