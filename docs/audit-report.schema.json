{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Amahdip/vidscope/docs/audit-report.schema.json",
  "title": "Vidscope audit report",
  "description": "The result of `vidscope audit`: every file checked against the streaming standards, and every ladder of versions of one content checked as a set.",
  "type": "object",
  "required": ["tool", "generated", "expect", "summary", "files", "ladders"],
  "properties": {
    "tool": {
      "type": "object",
      "properties": { "name": { "const": "vidscope" }, "command": { "const": "audit" }, "version": { "type": ["string", "null"] } },
      "required": ["name", "command"]
    },
    "generated": { "type": "string", "format": "date-time" },
    "expect": {
      "description": "What the service intends its outputs to be; rules with an expectation check it, rules without check only the standards.",
      "type": "object",
      "properties": {
        "gop": { "type": "number", "description": "seconds between key frames" },
        "gopMax": { "type": "number" },
        "fpsMax": { "type": "number" },
        "fpsMin": { "type": "number" },
        "peakRatio": { "type": "number", "description": "busiest second ÷ average, at most" },
        "colour": { "type": "object", "properties": { "primaries": { "type": "integer" }, "transfer": { "type": "integer" }, "matrix": { "type": "integer" } } },
        "audio": { "type": "object", "properties": { "codec": { "type": "string" }, "sampleRate": { "type": "integer" }, "channelsMax": { "type": "integer" }, "minBitratePerChannel": { "type": "integer" } } },
        "loudness": { "type": "object", "properties": { "integrated": { "type": "number" }, "tolerance": { "type": "number" }, "truePeakMax": { "type": "number" } } },
        "segments": { "type": "array", "items": { "type": "number" } }
      }
    },
    "summary": { "$ref": "#/$defs/tally" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "facts", "checks"],
        "properties": {
          "input": { "type": "string", "description": "the path or URL given" },
          "file": { "type": "string" },
          "ms": { "type": "integer" },
          "facts": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "size": { "type": "integer" },
              "format": { "type": ["string", "null"] },
              "duration": { "type": ["number", "null"] },
              "bytesRead": { "type": ["integer", "null"], "description": "bytes fetched to audit the file: the index in full, then the frame budget" },
              "requests": { "type": ["integer", "null"] },
              "payload": { "type": ["object", "null"], "properties": { "gopsRead": { "type": "integer" }, "gops": { "type": "integer" } } },
              "video": {
                "type": ["object", "null"],
                "properties": {
                  "codec": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "fps": { "type": ["number", "null"] },
                  "profile": { "type": ["string", "null"] }, "level": { "type": ["integer", "null"], "description": "level_idc (42 = 4.2)" }, "depth": { "type": ["integer", "null"] },
                  "bitrate": { "type": ["number", "null"] }, "peak": { "type": ["number", "null"] }, "gop": { "type": ["number", "null"] }, "bpp": { "type": ["number", "null"] },
                  "colour": { "type": ["string", "null"], "description": "primaries/transfer/matrix as in H.273" }, "timescale": { "type": ["integer", "null"] }
                }
              },
              "audio": { "type": ["object", "null"], "properties": { "codec": { "type": "string" }, "sampleRate": { "type": ["integer", "null"] }, "channels": { "type": ["integer", "null"] }, "bitrate": { "type": ["number", "null"] } } },
              "encoder": { "type": ["object", "null"], "properties": { "label": { "type": "string" }, "version": { "type": ["string", "null"] }, "crf": {}, "maxrate": {}, "bufsize": {}, "keyint": {} } }
            }
          },
          "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
        }
      }
    },
    "ladders": {
      "type": "array",
      "items": { "type": "object", "required": ["files", "checks"], "properties": { "files": { "type": "array", "items": { "type": "string" } }, "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } } } }
    },
    "specs": { "type": "object", "additionalProperties": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "category", "level", "title", "text", "spec"],
      "properties": {
        "id": { "type": "string", "description": "the rule, stable across versions (e.g. colour-signalled)" },
        "category": { "type": "string", "enum": ["Container", "Video", "Colour", "Audio", "Ladder"] },
        "level": { "type": "string", "enum": ["pass", "warn", "fail", "info", "skip"] },
        "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"], "description": "present on warn and fail only: what the finding means for viewers and players" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "spec": { "type": "string", "description": "key into specs" },
        "clause": { "type": ["string", "null"] },
        "value": { "description": "what was measured" },
        "expected": { "description": "what the rule or the expectation wanted" },
        "offset": { "type": "integer", "description": "byte offset in the file of the box, parameter set or sample the finding is about" },
        "remedy": { "type": "object", "properties": { "cause": { "type": "string" }, "fix": { "type": "string" } } }
      }
    },
    "tally": {
      "type": "object",
      "properties": {
        "pass": { "type": "integer" }, "warn": { "type": "integer" }, "fail": { "type": "integer" }, "info": { "type": "integer" }, "skip": { "type": "integer" },
        "critical": { "type": "integer" }, "warning": { "type": "integer" },
        "compliance": { "type": ["number", "null"], "description": "passed ÷ (passed + failed), warnings aside" }
      }
    }
  }
}
